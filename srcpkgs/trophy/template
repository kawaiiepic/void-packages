# Template file for 'trophy'
pkgname=trophy
version=0.12.1
revision=1
archs="x86_64*"
build_style=cmake
configure_args="-DAPP_VERSION=v${version} -DBUILD_TESTING=OFF
 -DENABLE_VAAPI=ON -DQT_QML_GENERATE_QMLLS_INI=OFF"
hostmakedepends="git pkg-config qt6-base qt6-declarative-host-tools"
makedepends="qt6-base-devel qt6-declarative-devel qt6-multimedia-devel
 ffmpeg-devel pipewire-devel libdrm-devel MesaLib-devel
 libva-devel vulkan-loader-devel libyaml-devel sqlite-devel"
depends="qt6-wayland qt6-declarative qt6-multimedia
 qt6-svg xdg-desktop-portal"
short_desc="Wayland game recorder and replay clip manager"
maintainer="kawaiiepic <59005594+kawaiiepic@users.noreply.github.com>"
license="GPL-3.0-only"
homepage="https://github.com/kawaiiepic/Trophy"

# Pin the upstream v0.12.1 commit used by the fork's clean baseline.
_trophy_commit=1d603e8b0feb1e013b4eea40f36dbedb6d56d0df
do_fetch() {
	git init -q "${wrksrc}"
	git -C "${wrksrc}" fetch -q --depth 1 \
		https://github.com/kawaiiepic/Trophy.git "${_trophy_commit}"
	git -C "${wrksrc}" checkout -q --detach FETCH_HEAD
}

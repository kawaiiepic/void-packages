pre_configure() {
    [ -f CMakeLists.txt ] ||
        msg_error "CMakeLists.txt not found in $PWD\n"

    # Populate submodules from XBPS-managed distfiles.
    # No git submodule downloads during the build.
    _sub() {
    local src="${wrksrc}/$1"
    local dst="src/External/$2"

    [ -d "$src" ] ||
        msg_error "Missing submodule source: $src\n"

    mkdir -p "$dst"
    cp -a "$src"/. "$dst"/
}

    _sub "glslang-WallpaperEngine-${_glslang}" \
        glslang-WallpaperEngine

    _sub "SPIRV-Cross-WallpaperEngine-${_spirv}" \
        SPIRV-Cross-WallpaperEngine

    _sub "stb-${_stb}" stb
    _sub "json-${_json}" json
    _sub "MimeTypes-${_mime}" MimeTypes
    _sub "kissfft-${_kiss}" kissfft
    _sub "argparse-${_argp}" argparse
    _sub "quickjs-${_qjs}" quickjs

    # Stage CEF before CMake configuration.
    local cef_src="${wrksrc}/cef_binary_${_cef}_linux64_minimal"

    [ -d "$cef_src" ] ||
        msg_error "CEF source directory not found: $cef_src\n"

    mkdir -p build/cef
    cp -a "$cef_src" build/cef/

    # Prevent tests from requiring Catch2.
    # Avoid executing tests in the source build.
}

post_install() {
    vlicense LICENSE

    # Standalone launcher
    vmkdir usr/bin

    cat > "${DESTDIR}/usr/bin/linux-wallpaperengine" <<'EOF'
#!/bin/sh
cd /opt/linux-wallpaperengine || exit 1
exec ./linux-wallpaperengine "$@"
EOF

    chmod 755 "${DESTDIR}/usr/bin/linux-wallpaperengine"
}


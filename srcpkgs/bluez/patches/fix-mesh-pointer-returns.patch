From: Void Linux Trophy branch
Subject: [PATCH] mesh: use NULL for pointer-valued failure returns

BlueZ 5.86 mesh helper functions return pointers, so error branches must
return NULL instead of the boolean 'false', which is not a pointer in C.

--- a/tools/mesh/mesh-db.c
+++ b/tools/mesh/mesh-db.c
@@ -803,8 +803,8 @@ static json_object *get_element(uint16_t unicast, uint16_t ele_addr)
 	int i, ele_cnt;
 
 	jnode = get_node_by_unicast(cfg->jcfg, unicast);
 	if (!jnode)
-		return false;
+		return NULL;
 
 	if (!json_object_object_get_ex(jnode, "elements", &jarray))
 		return NULL;
@@ -840,8 +840,8 @@ static json_object *get_model(uint16_t unicast, uint16_t ele_addr,
 	int i, sz;
 
 	jelement = get_element(unicast, ele_addr);
 	if (!jelement)
-		return false;
+		return NULL;
 
 	if (!json_object_object_get_ex(jelement, "models", &jarray))
 		return NULL;
@@ -2523,7 +2523,7 @@ void *mesh_db_prepare_export(void)
 	json_object *export = NULL, *jarray;
 
 	if (!cfg || !cfg->jcfg)
-		return false;
+		return NULL;
 
 	if (json_object_deep_copy(cfg->jcfg, &export, NULL) != 0)
 		return NULL;
